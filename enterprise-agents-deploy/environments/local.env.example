# LOCAL DEVELOPMENT ONLY. Use a secrets manager or protected files in production.
POSTGRES_PASSWORD=change_this_local_database_password
KEYCLOAK_ADMIN_PASSWORD=change_this_local_admin_password
OIDC_ISSUER=http://localhost:8080/realms/agentops
OIDC_AUTHORITY=http://localhost:8080/realms/agentops
APP_ORIGIN=http://localhost:8080
GRAFANA_ADMIN_PASSWORD=change_this_local_grafana_password
OLLAMA_MODEL=llama3.2:3b
MINIO_ROOT_USER=localminioadmin
MINIO_ROOT_PASSWORD=change_this_local_object_storage_password

# Optional self-hosted OAuth enterprise connector. Keep disabled unless configured.
CONNECTOR_OAUTH_AUTH_URL=
CONNECTOR_OAUTH_TOKEN_URL=
CONNECTOR_OAUTH_REVOKE_URL=
CONNECTOR_OAUTH_PROFILE_URL=
CONNECTOR_OAUTH_CLIENT_ID=
CONNECTOR_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/integrations/oauth/callback
CONNECTOR_OAUTH_SCOPES=openid profile email
KNOWLEDGE_EMBED_MODEL=nomic-embed-text

KEYCLOAK_START_MODE=dev
CADDY_SITE_ADDRESS=:80
CADDY_BIND_IP=127.0.0.1
CADDY_HTTP_PORT=8080
DOCS_ENABLED=true
