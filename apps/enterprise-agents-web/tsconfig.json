{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "@enterprise-agents/contracts": [
        "../enterprise-agents-impl/packages/contracts/dist/contracts.d.ts"
      ],
      "@/*": ["./src/features/*"],
      "~/*": ["./src/*"]
    }
  },
  "include": ["src", "tests/setup.ts", "tests/test-utils.tsx", "vite.config.ts"]
}
