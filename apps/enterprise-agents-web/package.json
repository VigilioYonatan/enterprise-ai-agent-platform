{
  "name": "enterprise-agents-web",
  "version": "0.1.0-beta",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "format": "biome format --write src tests",
    "test:unit": "vitest run src",
    "test:coverage": "vitest run src --coverage",
    "test:e2e:accessibility": "playwright test tests/accessibility",
    "contracts:sync": "node ../../scripts/sync-web-contracts.mjs",
    "contracts:check": "node ../../scripts/sync-web-contracts.mjs --check",
    "quality:static": "npm run contracts:check && npm run lint && npm run typecheck && npm run build && npm run test:unit"
  },
  "dependencies": {
    "@enterprise-agents/contracts": "file:../enterprise-agents-impl/packages/contracts",
    "@hookform/resolvers": "^5.2.0",
    "@preact/signals-react": "^3.12.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "5.104.5",
    "@xyflow/react": "^12.8.0",
    "lucide-react": "^0.468.0",
    "oidc-client-ts": "^3.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
