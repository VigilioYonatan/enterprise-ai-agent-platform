{
  "name": "enterprise-agents-impl",
  "version": "0.1.0-beta",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:contracts": "tsc -p packages/contracts/tsconfig.build.json && node scripts/fix-esm-imports.cjs",
    "start": "node dist/main.js",
    "db:migrate": "node dist/database/migrate.js",
    "db:seed": "node dist/database/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "start:worker": "node dist/worker.main.js",
    "start:outbox": "node dist/outbox.main.js",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:bdd": "npm run build && cucumber-js tests/bdd/*.feature --require tests/bdd/*.cjs",
    "test:e2e:api": "vitest run --config vitest.e2e.config.mts",
    "openapi:export": "npm run build && node dist/bootstrap/export-openapi.js",
    "lint": "biome check .",
    "format": "biome format --write src tests",
    "test:coverage": "vitest run tests/unit --coverage",
    "test:e2e:security": "vitest run --config vitest.e2e.config.mts tests/e2e",
    "quality:static": "npm run lint && npm run typecheck && npm run build && npm run test:unit"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "^11.2.0",
    "@scalar/nestjs-api-reference": "^1.0.0",
    "drizzle-orm": "0.45.4",
    "jose": "^5.9.6",
    "nats": "^2.28.0",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@cucumber/cucumber": "^12.2.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "^0.31.4",
    "tsc-alias": "^1.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
